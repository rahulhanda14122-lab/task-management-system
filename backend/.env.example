# PostgreSQL
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=taskpass
POSTGRES_DB=taskdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Async URL used by the FastAPI app (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://taskuser:taskpass@postgres:5432/taskdb
# Sync URL used by Alembic migrations (psycopg2 driver)
DATABASE_URL_SYNC=postgresql+psycopg2://taskuser:taskpass@postgres:5432/taskdb

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Auth
JWT_SECRET_KEY=change-me-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Misc
PENDING_TASK_ALERT_HOURS=24
ELIGIBLE_USERS_PREVIEW_LIMIT=20
